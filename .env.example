# Port public du frontend/reverse-proxy.
NETLAB_HTTP_PORT=8080

# Compose démarre en développement afin de fonctionner en HTTP local.
# Pour une exposition publique, utiliser un reverse-proxy HTTPS et suivre PROTOTYPE.md.
NETLAB_ENV=development
NETLAB_COOKIE_SECURE=false
NETLAB_ALLOWED_ORIGINS=http://localhost:8080
NETLAB_ALLOWED_HOSTS=localhost,127.0.0.1

# FastAPI control plane
NETLAB_TOPOLOGY=topology.json
NETLAB_DATA_DIR=.netlab-data

# PostgreSQL utilisé par docker compose ; en local, laissez ces valeurs par défaut.
POSTGRES_DB=netlab
POSTGRES_USER=netlab
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Default multi-lab limits (lab count per owner; runtime quotas per user).
NETLAB_MAX_LABS_PER_USER=5
NETLAB_MAX_RUNNING_LABS_PER_USER=2
NETLAB_MAX_NODES_PER_LAB=20
NETLAB_MAX_CPU_CORES_PER_LAB=8
NETLAB_MAX_MEMORY_MB_PER_LAB=8192
NETLAB_MAX_STORAGE_MB_PER_LAB=100
NETLAB_MAX_RUNNING_CPU_CORES_PER_USER=8
NETLAB_MAX_RUNNING_MEMORY_MB_PER_USER=8192
NETLAB_LAB_TTL_HOURS=24
NETLAB_EXECUTION_BACKEND=docker
NETLAB_MAX_LIBVIRT_CPU_CORES_PER_LAB=8
NETLAB_MAX_LIBVIRT_MEMORY_MB_PER_LAB=16384
NETLAB_MAX_LIBVIRT_DISK_GB_PER_LAB=200

# Le worker Docker est le seul service qui reçoit le socket Docker.
# URL pour exécuter control et worker directement sur l'hôte (hors Compose).
NETLAB_WORKER_URL=http://127.0.0.1:9000
NETLAB_WORKER_TOKEN=replace-with-a-long-random-token

# Compose doit utiliser les noms DNS internes des services, indépendamment
# de NETLAB_WORKER_URL/NETLAB_CONTROL_URL utilisés pour le mode hôte.
NETLAB_COMPOSE_WORKER_URL=http://worker:9000
NETLAB_COMPOSE_CONTROL_URL=http://control:8000

# Worker binds locally by default. Expose it only behind a private network or mTLS.
NETLAB_WORKER_HOST=127.0.0.1
NETLAB_WORKER_PORT=9000
# Leave empty so each container uses its unique hostname (required when scaling workers).
NETLAB_WORKER_ID=
NETLAB_WORKER_NAME=
NETLAB_WORKER_MAX_ATTEMPTS=3

# Certificats injectés en lecture seule dans les conteneurs Compose.
NETLAB_CONTROL_CERTS_DIR=./certs/control
NETLAB_WORKER_CERTS_DIR=./certs/worker

# Production : le control plane présente un certificat client au worker.
# Les chemins pointent dans /run/netlab/control-certs.
# NETLAB_MTLS_CA_FILE=/run/netlab/control-certs/ca.crt
# NETLAB_MTLS_CERT_FILE=/run/netlab/control-certs/control.crt
# NETLAB_MTLS_KEY_FILE=/run/netlab/control-certs/control.key

# Production : le worker exige un certificat client sur son endpoint HTTPS.
# NETLAB_MTLS_SERVER_CERT_FILE=/run/netlab/worker-certs/worker.crt
# NETLAB_MTLS_SERVER_KEY_FILE=/run/netlab/worker-certs/worker.key
# NETLAB_MTLS_SERVER_CA_FILE=/run/netlab/worker-certs/ca.crt

# Production : le worker s'authentifie aussi auprès du control plane HTTPS.
# NETLAB_CONTROL_MTLS_CA_FILE=/run/netlab/worker-certs/control-ca.crt
# NETLAB_CONTROL_MTLS_CERT_FILE=/run/netlab/worker-certs/worker-client.crt
# NETLAB_CONTROL_MTLS_KEY_FILE=/run/netlab/worker-certs/worker-client.key
# NETLAB_CONTROL_URL=https://control.internal.example.org
# NETLAB_WORKER_URL=https://worker.internal.example.org
# NETLAB_DATABASE_URL=postgresql://netlab:secret@postgres.internal:5432/netlab?sslmode=verify-full

# Jeton à usage initial pour créer le premier compte enseignant.
NETLAB_BOOTSTRAP_TOKEN=replace-with-a-long-random-bootstrap-token
# Facultatif : utiliser "admin" pour attribuer le rôle administrateur au premier compte.
NETLAB_BOOTSTRAP_ROLE=teacher

# Images autorisées par le worker et le control plane.
NETLAB_ALLOWED_IMAGES=netlab/ubuntu-lab:24.04,netlab/debian-lab:bookworm,netlab/debian-router:bookworm,nginx:stable-alpine,httpd:2.4-alpine,coredns/coredns:1.12.0,postgres:17-alpine,mysql:8.4,mongo:8

# Secrets de services : une topologie ne contient que secret_refs, par exemple
# {"POSTGRES_PASSWORD": "lab-password"}; la valeur réelle est ici.
# Le worker lit NETLAB_SECRET_<REFERENCE_EN_MAJUSCULES>.
# NETLAB_SECRET_LAB_PASSWORD=replace-with-a-secret

# Public deployment: do not copy development values or expose the worker/Docker socket.
# Configure PostgreSQL, HTTPS termination, a private worker network, and a reverse-proxy
# rate limit before setting NETLAB_ENV=production.
# NETLAB_ENV=production
# NETLAB_COOKIE_SECURE=true
# NETLAB_ALLOWED_ORIGINS=https://netlab.example.org
# NETLAB_ALLOWED_HOSTS=netlab.example.org
# NETLAB_ENABLE_INTERACTIVE_TERMINAL=false
# NETLAB_WORKER_URL=https://worker.internal.example.org
# NETLAB_WORKER_TOKEN=<generate-at-least-32-random-characters>
