{
  "version": 1,
  "lab": "linux-ping-demo",
  "network": {
    "name": "netlab-demo",
    "driver": "bridge",
    "subnet": "172.30.0.0/24"
  },
  "nodes": [
    {
      "name": "client-ubuntu",
      "image": "ubuntu:24.04",
      "command": [
        "sleep",
        "infinity"
      ],
      "position": {
        "x": 120.0,
        "y": 130.0
      }
    },
    {
      "name": "server-debian",
      "image": "debian:bookworm-slim",
      "command": [
        "sleep",
        "infinity"
      ],
      "position": {
        "x": 520.0,
        "y": 130.0
      }
    }
  ],
  "connectivity_check": {
    "from": "client-ubuntu",
    "to": "server-debian",
    "command": [
      "getent",
      "server-debian"
    ]
  },
  "links": [
    {
      "from": "client-ubuntu",
      "to": "server-debian"
    }
  ]
}
